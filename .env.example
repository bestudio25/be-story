# ═══ BE STORY · Memórias ═══ (copie para .env.local em desenvolvimento; na Netlify, cadastre em Site settings → Environment variables)

# Endereço público
NEXT_PUBLIC_SITE_URL=https://memorias.bestudiomkt.com.br
# Texto aleatório longo (assina cookies e links). Ex.: openssl rand -base64 48
SESSION_SECRET=
# Código do link de primeiro acesso ao painel: /admin/login?setup=ESTE_CODIGO (pode apagar depois de criar sua conta)
SETUP_TOKEN=

# Banco Postgres (Neon → Connection string, com ?sslmode=require)
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=be-story-media
SIGNED_URL_TTL=21600

# Google Drive (conta de serviço, só leitura) — compartilhe a pasta-mãe dos eventos com o e-mail dela como Leitor
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# GitHub (acorda o worker na hora; sem isso ele roda a cada 15 min)
GITHUB_REPO=usuario/be-story
GITHUB_TOKEN=

# Avisos por e-mail (opcional, Resend)
RESEND_API_KEY=
EMAIL_FROM="BE Studio <memorias@bestudiomkt.com.br>"
BE_NOTIFY_EMAIL=atendimento@bestudiomkt.com.br

# Marca
NEXT_PUBLIC_BE_INSTAGRAM=bestudioaudiovisual
NEXT_PUBLIC_BE_WHATSAPP=5588994547613

# Só desenvolvimento local
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.media
# LOCAL_SOURCE_DIR=/caminho/das/pastas
